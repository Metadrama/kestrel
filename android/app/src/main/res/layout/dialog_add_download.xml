<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_download_title"
        android:textColor="@color/text_white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etDialogUrl"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/dialog_input_background"
        android:hint="@string/url_hint"
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_white"
        android:textSize="13sp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:inputType="textUri"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/btnDialogCancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/btn_cancel"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnDialogDownload"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/btn_accent_background"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/btn_download"
            android:textColor="@color/bg_obsidian"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
