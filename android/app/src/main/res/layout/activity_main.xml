<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_obsidian">

    <!-- Top "Kestrel" Header -->
    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="16dp"
        android:text="@string/app_name"
        android:textColor="@color/text_white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Download Cards List -->
    <ListView
        android:id="@+id/lvDownloads"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tvHeaderTitle"
        android:divider="@null"
        android:dividerHeight="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="96dp"
        android:clipToPadding="false"
        android:scrollbars="none" />

    <!-- Bottom Floating Pill Capsule Button with Centered + Icon -->
    <LinearLayout
        android:id="@+id/btnFloatingAdd"
        android:layout_width="190dp"
        android:layout_height="54dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="28dp"
        android:background="@drawable/floating_pill_background"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/floating_pill_add_button"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:textStyle="normal" />
    </LinearLayout>

</RelativeLayout>
