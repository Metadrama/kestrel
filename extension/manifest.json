{
  "manifest_version": 3,
  "name": "Kestrel Download Interceptor",
  "version": "1.0.0",
  "description": "High-speed multi-threaded download engine and media stream capture for Kestrel",
  "permissions": [
    "downloads",
    "webRequest",
    "nativeMessaging",
    "activeTab",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kestrel Downloader"
  }
}
